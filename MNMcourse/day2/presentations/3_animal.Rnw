\section{Biophysical processes}
\subsection{Biophysical Ecology processes}


\begin{frame}
  \frametitle{Biophysical Ecology processes}

  \begin{figure}
    \begin{center}
      \begin{tikzpicture}
        \node[anchor=south west, inner sep=0] (img) at (0,0) {\includegraphics[width=0.4\textwidth]{../../resources/images/frog_pic.jpg}};
        \begin{scope}[x={(img.south east)}, y={(img.north west)}]
