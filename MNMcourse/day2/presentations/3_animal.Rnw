\section{Biophysical ecology framework}
\subsection{What is biophysical ecology?}

\begin{frame}
  \frametitle{Biophysical ecology}

  Biophysical ecology applies the principles of thermodynamics to organisms
  to derive mechanistic models of energy and mass exchange
  \parencite{porter1969,gates1980,porter1973}.

  \vfill

  \begin{block}{Core idea}
    Organisms are open thermodynamic systems exchanging heat, water, and
    gases with their environment. These exchanges can be described by
    the conservation laws of physics.
  \end{block}

  \vfill

  % \begin{itemize}
  %   \item Heat transfer: conduction, convection, radiation, evaporation
  %   \item Mass transfer: water, respiratory gases, food
  %   \item Momentum transfer: locomotion, fluid dynamics
  % \end{itemize}

\end{frame}

