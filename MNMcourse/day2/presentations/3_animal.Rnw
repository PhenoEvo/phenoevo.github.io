          node[pos=1, anchor=south, label] {solar radiation}
          node[pos=0.9, anchor=west, eqn] {\(\dot{Q}_{solar} = A_d a S\)};
          % EVAPORATION (outgoing to right)
          \draw[cyan, -{Stealth},thick] (0.6, 0.8) -- ++(0.15, 0.3)
          node[pos=1, anchor=south west, label] {evaporation}
          node[pos=0.8, anchor=west, eqn] {\(\dot{Q}_{evap} = A_d h_d(\rho_{skin} - \rho_{air}) \Delta H_{vap}\)};
          % INFRARED (outgoing to left)
          \draw[orange, -{Stealth}, wavy, decoration={post length=2mm}] (0.15, 0.6) -- ++(-0.25, -0.25)
          node[pos=1, anchor=north east, label] {infrared radiation}
