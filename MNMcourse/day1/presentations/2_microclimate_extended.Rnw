\section{Strengths and limitations}
\subsection{Key takeaways}

\begin{frame}
  \frametitle{Strengths}

  \begin{itemize}
    \item Mechanistic
    \item Physically realistic
    \item Fine temporal resolution
    \item Flexible inputs
    \item Global applicability
  \end{itemize}

  \vspace{0.3cm}

  \uncover<2->{
    \textbf{Limitations}

    \begin{itemize}
      \item Point-based model
      \item No lateral heat flow
      \item Requires many parameters
      \item Sensitive to input quality
    \end{itemize}
  }

\end{frame}

\section{Final conclusions}
\subsection{Why this paper matters}

\begin{frame}
  \frametitle{NicheMapR helped establish:}

  \begin{itemize}
    \item Mechanistic species distribution modelling
    \item Process-based climate biology
    \item Modern ecological biophysics workflows
  \end{itemize}

  \vspace{0.3cm}

  \uncover<2->{
    \textbf{Main message}

    \begin{alertblock}{Core insight}
      Organisms experience microclimates, not climate averages.
    \end{alertblock}
  }

\end{frame}

