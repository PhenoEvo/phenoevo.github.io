\section{NicheMapR: motivation and context}
\subsection{Why do we need microclimate models?}

\begin{frame}
  \frametitle{Climate is not enough}

  \begin{itemize}
    \item Weather stations measure conditions \textasciitilde1--2 m above ground
    \item Organisms experience conditions near the surface
    \item Microclimates determine:
          \begin{itemize}
            \item heat exchange
            \item water balance
            \item behaviour
            \item survival and reproduction
          \end{itemize}
    \item Fine-scale thermal heterogeneity is ecologically critical
  \end{itemize}

  \vspace{0.3cm}

  \begin{block}{Key idea}
    Microclimate is the physical environment actually experienced by organisms.
  \end{block}

\end{frame}

\section{NicheMapR overview}
\subsection{What is NicheMapR?}

\begin{frame}
  \frametitle{A mechanistic microclimate modelling framework}

  \begin{itemize}
    \item Developed by Kearney \& Porter (2016)
    \item R package + Fortran computational engine
    \item Predicts hourly above- and below-ground conditions
    \item Inputs:
          \begin{itemize}
            \item weather
            \item terrain
            \item vegetation
            \item soil properties
          \end{itemize}
    \item Outputs:
          \begin{itemize}
            \item solar radiation
            \item soil temperature
            \item air temperature
            \item humidity
            \item snow and soil moisture
          \end{itemize}
  \end{itemize}

\end{frame}

\section{Why is this important?}
\subsection{Ecological applications}

\begin{frame}
  \frametitle{NicheMapR has been used for:}

  \begin{itemize}
    \item Thermoregulation studies
    \item Species distribution modelling
    \item Climate change buffering analyses
    \item Nest temperature prediction
    \item Conservation translocations
    \item Ectotherm energetics
    \item Landscape resistance modelling
  \end{itemize}

  \begin{alertblock}{Main strength}
    Mechanistic models allow prediction under novel environmental conditions.
  \end{alertblock}

\end{frame}

\section{Overall architecture}
\subsection{Model structure}

\begin{frame}
  \frametitle{Two main layers}

  \begin{columns}[T]

    \column{0.48\textwidth}

    \textbf{Fortran engine}

    \begin{itemize}
      \item Numerical computations
      \item Radiation physics
      \item Soil heat transfer
      \item Moisture dynamics
      \item Snow modelling
    \end{itemize}

    \column{0.48\textwidth}

    \textbf{R interface}

    \begin{itemize}
      \item Data preparation
      \item Global climate databases
      \item Running simulations
      \item Visualization
      \item User customization
    \end{itemize}

  \end{columns}

  \vspace{0.3cm}

\end{frame}

\section{Core workflow}
\subsection{Main computational routines}

\begin{frame}
  \frametitle{Main computational routines}

  \begin{enumerate}
    \item \textbf{MICROCLIMATE}
          \begin{itemize}
            \item master control routine
            \item handles iterations and outputs
          \end{itemize}

    \item \textbf{SOLRAD}
          \begin{itemize}
            \item solar geometry
            \item direct + diffuse radiation
          \end{itemize}

    \item \textbf{SINEC / VSINE}
          \begin{itemize}
            \item interpolate hourly weather profiles
          \end{itemize}

    \item \textbf{SFODE / DSUB}
          \begin{itemize}
            \item solve substrate heat equations
          \end{itemize}

    \item \textbf{OSUB}
          \begin{itemize}
            \item outputs
            \item snow and moisture updates
          \end{itemize}
  \end{enumerate}

\end{frame}

\section{Solar radiation}
\subsection{One of the most important drivers}

\begin{frame}
  \frametitle{Extra-terrestrial radiation}

  The wavelength-specific irradiance reaching a plane perpendicular to the sun is:

  \[I_\lambda = S_\lambda \left( \frac{a}{r} \right)^2 \cos Z\]

  where $S_\lambda$ is the solar spectral irradiance at one astronomical unit, $(a/r)^2$ is the Earth-Sun distance correction, and $Z$ is the zenith angle.

  \vspace{0.2cm}

  \uncover<2->{
    The \textbf{zenith angle} is derived from the astronomical triangle:

    \[\cos Z = \cos \phi \cos \delta \cos h + \sin \phi \sin \delta\]

    where $\phi$ is latitude, $\delta$ is solar declination, and $h$ is the hour angle.
  }

  \vspace{0.2cm}

  \uncover<3->{
    \begin{block}{Spectral resolution}
      NicheMapR calculates solar radiation across 111 wavelengths from 0.290 to 4 $\mu$m.
    \end{block}
  }

\end{frame}

\begin{frame}
  \frametitle{Extra-terrestrial radiation}
<<solar-irradiance, out.width='0.7\\textwidth', echo=FALSE, fig.width=7, fig.height=5, fig.cap='Solar spectral irradiance as a function of wavelength'>>=
optical <- read.csv("~/Documents/GitHub/NicheMapR/vignettes/OPTICAL.csv")
par(mar = c(5, 5, 2, 2) + 0.1)
plot(optical[, 2] ~ optical[, 1],
  type = "l", lwd = 2,
  ylab = expression(paste("solar spectral irradiance, W m"^{-2})),
  xlab = "wavelength, nm"
)
@
\end{frame}

\begin{frame}
  \frametitle{Atmospheric attenuation}

  As radiation passes through the atmosphere, it is attenuated by four primary processes, each with a wavelength-specific extinction coefficient:

  \begin{enumerate}
    \item \textbf{Rayleigh scattering} ($\tau_R$) --- molecular scattering, adjusted for local barometric pressure
    \item \textbf{Aerosol extinction} ($\tau_A$) --- scattering and absorption by dust and salt; uses the Global Aerosol Data Set (GADS)
    \item \textbf{Ozone absorption} ($\tau_O$) --- wavelength-specific absorption based on seasonal and latitudinal ozone columns
    \item \textbf{Water vapour absorption} ($\tau_W$) --- function of precipitable water in the air column
  \end{enumerate}

  \vspace{0.2cm}

  \uncover<2->{
    The total monochromatic extinction coefficient is:

    \scriptsize
    \[
    _\lambda \tau(Z_a) = m(Z_a) \Big[ (\tfrac{P}{1013})\, _\lambda \tau_R A_R + (\tfrac{25}{MR_0})\, _\lambda \tau_A A_A + (\tfrac{X}{0.34})\, _\lambda \tau_O A_O \Big] + \,_\lambda \tau_W \sqrt{m(Z_a) w A_W}
    \]
  }

\end{frame}

\begin{frame}
  \frametitle{Atmospheric attenuation}
<<optical-thickness, out.width='0.7\\textwidth', echo=FALSE, fig.width=7, fig.height=6, fig.cap='Wavelength-specific optical thickness for different atmospheric components'>>=
par(mfrow = c(2, 2))
par(mar = c(4, 4, 2, 1) + 0.1)
plot(optical[, 3] ~ optical[, 1], type = "l", lwd = 2,
  ylab = "optical thickness, cm", xlab = "wavelength, nm", main = "a) molecular")
plot(optical[, 5] ~ optical[, 1], type = "l", lwd = 2,
  ylab = "optical thickness, cm", xlab = "wavelength, nm", main = "b) ozone")
plot(optical[, 6] ~ optical[, 1], type = "l", lwd = 2,
  ylab = "optical thickness, cm", xlab = "wavelength, nm", main = "c) water")
plot(optical[, 4] ~ optical[, 1], type = "l", lwd = 2,
  ylab = "optical thickness, cm", xlab = "wavelength, nm", main = "d) aerosol")
@
\end{frame}


\begin{frame}
  \frametitle{Atmospheric attenuation}
<<ozone-lat, out.width='0.7\\textwidth', echo=FALSE, fig.width=7, fig.height=5, fig.cap='Seasonal and latitudinal variation in total atmospheric ozone (correction factor relative to 0.34 cm reference level)'>>=
oz <- read.csv("~/Documents/GitHub/NicheMapR/vignettes/OZ.csv")
par(mar = c(5, 5, 2, 2) + 0.1)
plot(oz[, 2] ~ oz[, 1], type = "b", ylim = c(0.2, 0.5),
  ylab = "ozone correction factor", xlab = "latitude",
  col = 2, pch = 2, lwd = 1)
for(i in 3:13){
  points(oz[, i] ~ oz[, 1], type = "b", pch = i, col = i, lwd = 1)
}
legend("topright", legend = c("Jan","Feb","Mar","Apr","May","Jun",
  "Jul","Aug","Sep","Oct","Nov","Dec"),
  pch = 2:13, col = 2:13, cex = 0.6, ncol = 2)
@
\end{frame}

\begin{frame}
  \frametitle{Atmospheric attenuation}
<<altitude-correction, out.width='0.7\\textwidth', echo=FALSE, fig.width=7, fig.height=5, fig.cap='Altitude correction factors for molecular, aerosol and ozone extinction'>>=
altfct <- read.csv("~/Documents/GitHub/NicheMapR/vignettes/ALTFCT.csv")
par(mar = c(5, 5, 2, 2) + 0.1)
plot(altfct[, 2] ~ altfct[, 1], type = "b", ylim = c(0, 1),
  ylab = "correction factor", xlab = "altitude, km",
  col = 1, pch = 1, lwd = 1, main = "Altitude correction")
points(altfct[, 3] ~ altfct[, 1], type = "b", col = 1, pch = 2, lwd = 1)
points(altfct[, 4] ~ altfct[, 1], type = "b", col = 1, pch = 3, lwd = 1)
legend("topright", legend = c("molecular", "aerosol", "ozone"),
  pch = 1:3, col = 1, cex = 0.8)
@
\end{frame}

\begin{frame}
  \frametitle{Slope, aspect and cloud effects}

  \textbf{Topographic correction:}

  The zenith angle for a sloping surface is:

  \[Z_{SL} = \arccos\big( \cos Z \cos SL + \sin Z \sin SL \cos(AZ_{SUN} - AZ_{SL}) \big)\]

  where $SL$ is the slope angle and $AZ_{SL}$ is the slope azimuth.

  \vspace{0.2cm}

  \uncover<2->{
    \textbf{Hill-shade:} Horizon angles in 24 directions can be specified. Direct radiation is set to zero when the sun is below the horizon in that direction.
  }

  \vspace{0.2cm}

  \uncover<3->{
    \textbf{Cloud cover adjustment:}

    \[\dot{Q}_{solar,cld} = \dot{Q}_{solar} \left( 0.36 + 0.64 \frac{1 - P_{cld}}{100} \right)\]

    where $P_{cld}$ is the percentage cloud cover (Angstrom formula).
  }

\end{frame}

\section{Terrain effects}
\subsection{Slope, aspect and hillshade}

\begin{frame}
  \frametitle{Local topography strongly modifies radiation}

  \begin{itemize}
    \item Slope changes solar incidence angle
    \item Aspect alters daily heat load
    \item Horizon angles create hillshade
    \item Vegetation creates shade heterogeneity
  \end{itemize}

  \vspace{0.3cm}

  \uncover<2->{
    \textbf{Ecological consequences}

    \begin{itemize}
      \item Thermal refuges
      \item Fine-scale niche partitioning
      \item Behavioural thermoregulation
      \item Climate buffering
    \end{itemize}
  }

\end{frame}

\section{Longwave radiation}
\subsection{Infrared heat exchange}

\begin{frame}
  \frametitle{Clear-sky and cloud longwave radiation}

  All objects emit longwave radiation proportional to $T^4$ (Stefan-Boltzmann law: $\dot{Q}_{IR} = \sigma \epsilon T^4$).

  \vspace{0.2cm}

  \textbf{Clear-sky emissivity} depends on air temperature and vapour pressure:

  \[\epsilon_{SKY} = 1.72 \left( \frac{e_A}{T_A} \right)^{\frac{1}{7}}\]

  \vspace{0.2cm}

  \uncover<2->{
    \textbf{Clear-sky radiation:}

    \[A_{RAD}= \sigma \epsilon_{SKY} (T_A+273)^4 (1-\frac{CLD}{100})\]

    \textbf{Cloud radiation} (assuming emissivity 1, temperature $T_A-2$):

    \[C_{RAD} = \sigma (T_A-2+273)^4 \frac{CLD}{100}\]
  }

\end{frame}

\begin{frame}
  \frametitle{Sky view factor and terrain shading}

  \textbf{Sky view factor} from horizon angles $HORI(i)$:

  \[VIEWF = 1 - \sum_{i=1}^n \frac{\sin (\frac{\pi}{180} HORI(i))}{n}\]

  \vspace{0.2cm}

  \uncover<2->{
    \textbf{Total sky radiation} (with shade fraction $SHD$):

    \[\dot{Q}_{IR,SKY} = (A_{RAD}+C_{RAD})(1-\frac{SHD}{100})\]
  }

  \vspace{0.2cm}

  \uncover<3->{
    \textbf{Vegetation and hill radiation} (both at air temperature):

    \[\dot{Q}_{IR,VEG} = C_{RAD} \frac{SHD}{100}\]
    \[\dot{Q}_{IR,HILL} = \sigma \epsilon_{HILL} (T_A+273)^4 (1-VIEWF)\]
  }

\end{frame}

\begin{frame}
  \frametitle{Ground emission}

  Assuming shaded ground radiates at shaded air temperature:

  \[\dot{Q}_{IR,GND} = \sigma \epsilon_{GND} (T_{surf}+273)^4 (1-\frac{SHD}{100})
    + \sigma \epsilon_{GND} (T_A+273)^4 \frac{SHD}{100}\]

  \vspace{0.3cm}

  \uncover<2->{
    \textbf{Five sources of longwave radiation are combined:}
    \begin{itemize}
      \item Clear-sky emission ($A_{RAD}$)
      \item Cloud emission ($C_{RAD}$)
      \item Vegetation radiation
      \item Hill radiation
      \item Ground emission
    \end{itemize}
  }

\end{frame}

\begin{frame}
  \frametitle{Net longwave exchange}

  The net longwave radiation gain for the substrate heat budget is:

  \[\dot{Q}_{IR}= (\dot{Q}_{IR,SKY} + \dot{Q}_{IR,VEG}) VIEWF + \dot{Q}_{IR,HILL} (1 - VIEWF) - \dot{Q}_{IR,GND}\]

  \vspace{0.3cm}

  \uncover<2->{
    \textbf{Effective sky temperature} (a model output):

    \[T_{SKY}= \left[ \frac{(\dot{Q}_{IR,SKY} + \dot{Q}_{IR,VEG}) VIEWF}{\sigma}
      + \frac{\dot{Q}_{IR,HILL} (1 - VIEWF)}{\sigma} \right]^\frac{1}{4}\]
  }

  \vspace{0.3cm}

  \uncover<3->{
    \begin{block}{Why it matters}
      Longwave radiation dominates nighttime environments, controls cooling rates, and is a major term in the surface heat budget.
    \end{block}
  }

\end{frame}

\section{Hourly weather interpolation}
\subsection{From daily to hourly conditions}

\begin{frame}
  \frametitle{Problem and solution}

  \textbf{Problem}

  Hourly observations are often unavailable.

  \vspace{0.3cm}

  \textbf{Solution}

  NicheMapR reconstructs hourly profiles using:

  \begin{itemize}
    \item Daily minimum temperature
    \item Daily maximum temperature
    \item Sunrise/sunset timing
    \item Solar noon
  \end{itemize}

  \vspace{0.3cm}

  \uncover<2->{
    \textbf{Two interpolation routines}

    \begin{itemize}
      \item \textbf{VSINE}: humidity, wind, cloud
      \item \textbf{SINEC}: air temperature
    \end{itemize}
  }

\end{frame}

\section{Boundary layer physics}
\subsection{Wind and air temperature profiles}

\begin{frame}
  \frametitle{Logarithmic wind profile}

  Macro-scale wind speeds are scaled to the organism's level using a logarithmic profile:

  \[u_z = \frac{u^*}{k} \ln \left( \frac{z - d}{z_0} + 1 \right)\]

  where $u^*$ is the friction velocity, $k$ is the von Karman constant (0.4), $z_0$ is the roughness length, and $d$ is the zero-plane displacement.

  \vspace{0.2cm}

  \uncover<2->{
    \textbf{Friction velocity:}

    \[u^* = \frac{0.4 \, u}{\ln(z / z_0 + 1)}\]

    where $u$ is the wind speed at the reference height $z$.
  }

\end{frame}

\begin{frame}
  \frametitle{Air temperature profile}

  The temperature at the roughness height is a weighted average of the reference air temperature and the substrate surface temperature:

  \[T_{z_0} = \frac{T_{ref} S_{t_b} + T_{sub} S_{t_s}}{S_{t_b} + S_{t_s}}\]

  where $S_{t_s}$ is the sublayer Stanton number and $S_{t_b}$ is the bulk Stanton number.

  \vspace{0.2cm}

  \uncover<2->{
    Air temperature at a local height $z_{loc}$:

    \[T_{loc} = T_{z_0} + (T_{ref} - T_{z_0}) \frac{\ln(z_{loc} / z_0 + 1)}{\ln(z / z_0 + 1)}\]
  }

  \vspace{0.2cm}

  \uncover<3->{
    \textbf{MICROSEGMT:} An alternative three-segment profile can be used when experimental data for two roughness heights are available.
  }

\end{frame}

\begin{frame}
  \frametitle{Convective heat transfer}

  Convective heat transfer at the surface is computed as:

  \[\dot{Q}_{conv} = \frac{0.08472}{T_{ave}} (T_{ref} - T_{sub}) \, u^* \frac{S_{t_b}}{1 + S_{t_b} / S_{t_s}}\]

  where $T_{ave}$ is the average of $T_{ref}$ and $T_{sub}$ in Kelvin.

  \vspace{0.3cm}

  \uncover<2->{
    \textbf{Important for:}

    \begin{itemize}
      \item Small ectotherms
      \item Ground nests
      \item Insects
      \item Reptiles
    \end{itemize}
  }

\end{frame}

\section{Surface evaporation}
\subsection{Latent heat exchange}

\begin{frame}
  \frametitle{Evaporation and mass transfer}

  Evaporation from the surface is calculated using the Chilton-Colburn mass transfer analogy, which assumes temperature and humidity profiles have the same shape.

  \vspace{0.2cm}

  \textbf{Mass transfer coefficient:}

  \[h_d = \frac{h_c}{c_p \rho_{air}} \left( \frac{0.71}{0.60} \right)^{0.666}\]

  \vspace{0.2cm}

  \uncover<2->{
    \textbf{Evaporation rate:}

    \[m_{evap} = \frac{P_{wet}}{100} h_d (v_{d,surf} - v_{d,air})\]

    where $P_{wet}$ is the percentage of the surface acting as free water, and $v_d$ is the vapour density.
  }

\end{frame}

\begin{frame}
  \frametitle{Latent heat of vaporisation}

  The evaporation rate is converted to energy flux:

  \[\dot{Q}_{evap} = m_{evap} \Delta H_{vap}\]

  \vspace{0.2cm}

  \textbf{Latent heat of vaporisation} depends on surface temperature:

  \vspace{0.1cm}

  If $T_{surf} > 0\,^\circ$C:

  \[\Delta H_{vap} = 10^3 (2500.8 - 2.36 T_{surf} + 0.0016 T_{surf}^2 - 0.00006 T_{surf}^3)\]

  \vspace{0.1cm}

  If $T_{surf} \leq 0\,^\circ$C:

  \[\Delta H_{vap} = 10^3 (2834.1 - 0.29 T_{surf} + 0.004 T_{surf}^2)\]

  \vspace{0.2cm}

  \uncover<2->{
    \begin{block}{Key point}
      The humidity gradient between the surface and the air drives evaporative cooling, a critical term in the surface energy balance.
    \end{block}
  }

\end{frame}

\section{Soil heat balance}
\subsection{Soil temperature dynamics}

\begin{frame}
  \frametitle{Heat diffusion equation}

  Below the surface, temperature $T$ at depth $z$ and time $t$ is governed by the 1D heat conduction equation:

  \[
    \frac{\partial T}{\partial t} = \frac{k}{\rho c}\frac{\partial^2 T}{\partial z^2}
  \]

  \vspace{0.3cm}

  \uncover<2->{
    \textbf{Numerical implementation:}
    \begin{itemize}
      \item 10 soil nodes, with closer spacing near the surface
      \item Adams predictor-corrector method with Runge-Kutta initialization
      \item \textbf{SOILPROPS:} Thermal conductivity $k$ and heat capacity $c$ updated hourly as a function of soil moisture
      \item \textbf{Bottom boundary:} Constant temperature at the 10th node (mean annual air temperature)
    \end{itemize}
  }

\end{frame}

\begin{frame}
  \frametitle{Surface energy balance}

  The model iterates to find a surface temperature $T_{surf}$ that satisfies the balance of all energy fluxes:

  \[\dot{Q}_{solar} + \dot{Q}_{IR,in} - \dot{Q}_{IR,out} - \dot{Q}_{conv} - \dot{Q}_{evap} - \dot{Q}_{cond} = 0\]

  or equivalently:

  \[R_{abs} + L_{net} + H + LE + G = 0\]

  \vspace{0.1cm}

  \uncover<2->{
    \begin{columns}[T]
      \column{0.48\textwidth}
      \textbf{Flux terms:}
      \begin{itemize}
        \item $\dot{Q}_{solar}$: absorbed solar radiation
        \item $\dot{Q}_{IR}$: net longwave exchange
        \item $\dot{Q}_{conv}$: sensible heat flux
        \item $\dot{Q}_{evap}$: latent heat flux
        \item $\dot{Q}_{cond}$: conduction into substrate
      \end{itemize}

      \column{0.48\textwidth}
      \textbf{Solver:}
      \begin{itemize}
        \item Bisection or Newton-Raphson method
        \item Iterates hourly for each time step
        \item Converges when $T_{surf}$ balances all fluxes
      \end{itemize}
    \end{columns}
  }

\end{frame}

\begin{frame}
  \frametitle{ODE system for soil nodes}

  The soil profile is discretised into nodes with separate ODEs solved for each:

  \vspace{0.1cm}

  \textbf{Surface node:}

  \[\frac{dT_{s,1}}{dt} = \frac{\dot{Q}_{solar} + \dot{Q}_{IR} + \dot{Q}_{conv} - \dot{Q}_{evap}}{C_{s,1}}\]

  \vspace{0.1cm}

  \textbf{Subsurface nodes:}

  \[\frac{dT_{s,i}}{dt} = \frac{K_{s,i-1}(T_{s,i-1} - T_{s,i}) + K_{s,i}(T_{s,i+1} - T_{s,i})}{C_{s,i}}\]

  \vspace{0.1cm}

  \uncover<2->{
    where for node $i$, heat capacity $C_i = \rho_{s,i} c_{s,i} (z_{i+1} - z_{i-1}) / 2$ and conductance $K_{s,i} = k_{s,i} (z_{i+1} - z_i)$.
  }

\end{frame}

\begin{frame}
  \frametitle{Soil thermal properties (SOILPROPS)}

  The subroutine \texttt{SOILPROPS} updates soil thermal properties hourly:

  \vspace{0.2cm}

  \begin{itemize}
    \item \textbf{Thermal conductivity $k_s$} --- adjusted for bulk density and soil moisture (Campbell et al. 1994)
    \item \textbf{Specific heat capacity $c_s$} --- adjusted for soil moisture and temperature
    \item \textbf{Density $\rho_s$} --- adjusted for bulk density and soil moisture
  \end{itemize}

  \vspace{0.2cm}

  \uncover<2->{
    \textbf{Latent heat of fusion:}
    \begin{itemize}
      \item When soil temperature is between $-0.45$ and $0.4^\circ$C and moisture is present
      \item $333.5$ J g$^{-1}$ is added to specific heat
    \end{itemize}
  }

  \vspace{0.2cm}

  \uncover<3->{
    \begin{block}{Flexibility}
      Users can specify up to 10 different soil profiles (one per node), each with unique conductivity, specific heat, density, and water-holding capacity.
    \end{block}
  }

\end{frame}

\section{Soil moisture and snow}
\subsection{Major model extensions}

\begin{frame}
  \frametitle{Campbell soil water model (C11.1)}

  The NicheMapR microclimate model integrates Campbell's (1985) Program 11.1 for simulating depth-specific soil moisture.

  \vspace{0.2cm}

  \textbf{Key features:}
  \begin{itemize}
    \item Uses matric potential as the dependent variable (most efficient when soil is relatively dry)
    \item Soil represented as capacitors and resistors (linearised through space)
    \item Newton-Raphson procedure to solve non-linear equations through time
    \item 19 moisture nodes (interpolated between the 10 heat nodes)
  \end{itemize}

  \vspace{0.2cm}

  \uncover<2->{
    \textbf{User inputs per node:}
    \begin{itemize}
      \item Campbell (Clapp-Hornberger) exponent $B$
      \item Air entry potential $P_e$ (J kg$^{-1}$)
      \item Hydraulic conductivity $K_s$ (kg s m$^{-3}$)
      \item Bulk density $\rho_b$ (Mg m$^{-3}$)
      \item Root density (m m$^{-3}$)
      \item Leaf area index $LAI$
    \end{itemize}
  }

\end{frame}

\begin{frame}
  \frametitle{Soil moisture coupling}

  The soil moisture subroutine (\texttt{INFIL}) is called from the hourly output routine \texttt{OSUB}:

  \vspace{0.2cm}

  \begin{itemize}
    \item Soil temperature from the current hour drives moisture calculations
    \item The resulting moisture profile is used in the next hour's temperature calculations
    \item \texttt{INFIL} iterates with a 6-minute step size for accuracy
    \item Daily rainfall is assumed to fall in the first hour of the day
  \end{itemize}

  \vspace{0.2cm}

  \uncover<2->{
    \textbf{Surface wetness:}
    \begin{itemize}
      \item Potential evaporation is computed from a completely wet surface
      \item Partitioned between evaporation and transpiration as a function of $LAI$
      \item Fractional surface wetness for the next hour's heat budget = ratio of actual to potential evapotranspiration
    \end{itemize}
  }

\end{frame}

\begin{frame}
  \frametitle{Snow model (SNOW-17)}

  An additional 8 snow nodes can be added above the 10 substrate nodes, with thermal properties set to ice when snow is present.

  \vspace{0.1cm}

  \textbf{Snow node depths:} 2.5, 5, 10, 20, 50, 100, 200, 300 cm

  \vspace{0.15cm}

  \uncover<2->{
    \textbf{Snow albedo decay} as a function of snow age $d_{snow}$:

    \[A = \frac{-9.8740 \ln(d_{snow}) + 78.3434}{100}\]
  }

  \vspace{0.15cm}

  \uncover<3->{
    \textbf{Snow thermal conductivity} (Djachkova's formula):

    \[k_{snow} = 0.0442 e^{5.181} \rho_{snow}\]
  }

\end{frame}

\begin{frame}
  \frametitle{Snow accumulation and melt}

  \textbf{Snow growth:}
  \begin{itemize}
    \item Driven by daily precipitation
    \item User specifies rain/snow temperature threshold and snow density
    \item All snow assumed to fall at midnight
    \item Subroutine \texttt{SNOWLAYER} tracks node activation as snow pack grows
  \end{itemize}

  \vspace{0.2cm}

  \uncover<2->{
    \textbf{Snow melt:}
    \begin{itemize}
      \item Melting when soil node pair mean temperature exceeds $0.4^\circ$C
      \item Heat input = change in mean temperature $\times$ snow heat capacity
      \item Rain-on-snow melt: rainfall $\times$ mean air temperature $\times$ 0.0125
    \end{itemize}
  }

\end{frame}

\section{Inputs and outputs}
\subsection{What does the model need?}

\begin{frame}
  \frametitle{Inputs}

  \begin{itemize}
    \item Air temperature
    \item Relative humidity
    \item Wind speed
    \item Cloud cover
    \item Rainfall
    \item Soil properties
    \item Terrain characteristics
    \item Vegetation structure
  \end{itemize}

  \vspace{0.3cm}

  \uncover<2->{
    \textbf{Outputs}

    \begin{itemize}
      \item Soil temperature profiles
      \item Air temperature profiles
      \item Solar radiation
      \item Sky temperature
      \item Soil moisture
      \item Snow depth
      \item Wind profiles
    \end{itemize}
  }

\end{frame}

\section{Global datasets and R interface}
\subsection{Running the model globally}

\begin{frame}
  \frametitle{R to Fortran workflow}

  The complexity of the simultaneous ODEs requires Fortran's speed, while R provides the flexible interface.

  \vspace{0.2cm}

  \begin{enumerate}
    \item \textbf{\texttt{micro\_global} (R):} Aggregates climate (CRU), aerosol (GADS), and soil moisture (NOAA) data.
    \item \textbf{\texttt{microrun} (R interface):} Passes parameters and boundary conditions to the compiled Fortran DLL.
    \item \textbf{\texttt{MICROSEGMT} (Fortran):} Performs hourly iterations, solving the energy balance until $T_{surf}$ converges.
  \end{enumerate}

\end{frame}

\begin{frame}
  \frametitle{Input data sources and outputs}

  \textbf{Global databases:}
  \begin{itemize}
    \item \textbf{CRU:} Climate Research Unit (temperature, precipitation, cloud)
    \item \textbf{NOAA:} Soil moisture profiles
    \item \textbf{GADS:} Global Aerosol Data Set (5$^\circ$ grid, seasonal, humidity-dependent)
  \end{itemize}

  \vspace{0.3cm}

  \uncover<2->{
    \textbf{Output matrices:}
    \begin{itemize}
      \item \texttt{metout}: Surface and air conditions (temperature, humidity, wind)
      \item \texttt{soil}: Temperatures at 10 depths
      \item \texttt{soilmoist}: Water content and potential at 19 depths
    \end{itemize}
  }

  \vspace{0.3cm}

  \uncover<3->{
    \begin{block}{Benefit}
      Users can run microclimate simulations almost anywhere on Earth.
    \end{block}
  }

\end{frame}

