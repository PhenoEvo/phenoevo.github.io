<<setup, include=FALSE>>=
knitrmini::opts_chunk$set(
  echo = FALSE,
  message = FALSE,
  warning = FALSE,
  cache.comments = TRUE,
  dev = "tikz",
  fig.ext = "tex"
)
@

<<label=Rcode, include=FALSE, cache=TRUE>>=
library(deSolve)
library(ecostudy)

data(lynxhare)

lynxhare_df <- as.data.frame(lynxhare)

lv_model <- function(t, state, parameters) {
  with(as.list(c(state, parameters)), {
    dx <- alpha * x - beta * x * y
    dy <- delta * x * y - gamma * y
    list(c(dx, dy))
  })
}

parameters <- c(
  alpha = 0.6,
  beta  = 0.07,
  delta = 0.04,
  gamma = 0.9
)

state <- c(
  x = lynxhare_df$Hare[1],
  y = lynxhare_df$Lynx[1]
)

times <- seq(1, nrow(lynxhare_df), by = 1)

out <- ode(
  y = state,
  times = times,
  func = lv_model,
  parms = parameters
)

out_df <- as.data.frame(out)

out_df$x_scaled <- as.numeric(out_df$x) *
  max(lynxhare_df$Hare) / max(out_df$x)

out_df$y_scaled <- as.numeric(out_df$y) *
  max(lynxhare_df$Lynx) / max(out_df$y)
@
\frame{\titlepage}

