%       \hline
%     \end{tabular}%
%   }
% \end{frame}

\begin{frame}
  \frametitle{The integrative picture}

  \begin{block}{Take-home message}
    Each component operates at different spatial and temporal scales. Together, they generate the microclimate that determines whether and how organisms persist.
  \end{block}

  \vspace{0.3cm}

  Every organism --- whether a basking lizard, a buried turtle egg, or a hibernating amphibian --- experiences a unique combination of these components at its specific location, height, depth, and time of day.
\end{frame}

\section{Inputs, outputs, and global data}
\subsection{Running the model}

\begin{frame}
  \frametitle{Inputs and outputs}

  \textbf{Inputs:}
  \begin{itemize}
    \item Air temperature, relative humidity, wind speed
    \item Cloud cover, rainfall
    \item Soil properties: conductivity, density, water-holding capacity
    \item Terrain: slope, aspect, horizon angles
    \item Vegetation: shade fraction, leaf area index
  \end{itemize}

  \vspace{0.2cm}

  \textbf{Outputs:}
  \begin{itemize}
    \item Hourly soil temperature at multiple depths
    \item Air temperature, relative humidity and wind speed at user-specified heights
    \item Solar and longwave radiation components
    \item Sky temperature, soil moisture, snow depth
  \end{itemize}
\end{frame}

\begin{frame}
  \frametitle{Global workflow}

  \begin{enumerate}
    \item \textbf{\texttt{micro\_global}} (R): Aggregates climate \parencite{new2002}, aerosols (GADS), and soil moisture (NOAA) data for any location
    \item \textbf{\texttt{microrun}} (R interface): Passes parameters to the Fortran DLL
    \item \textbf{Fortran engine}: Performs hourly iterations, solving the energy balance until $T_{surf}$ converges
  \end{enumerate}

  \vspace{0.3cm}

  \textbf{Key output matrices:}
  \begin{itemize}
    \item \texttt{metout}: surface and air conditions, hourly
    \item \texttt{soil}: temperatures at 10 depths, hourly
    \item \texttt{soilmoist}: water content and potential at 19 depths
  \end{itemize}

  \vspace{0.2cm}

  \begin{block}{Global applicability}
    Users can run microclimate simulations anywhere on Earth using built-in global datasets.
  \end{block}
\end{frame}

\section{The egg microclimate}
\subsection{A case study}

\begin{frame}
  \frametitle{The egg microclimate}

