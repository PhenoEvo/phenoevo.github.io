\section{Strengths and limitations}
\subsection{Key takeaways}

\begin{frame}
  \frametitle{Strengths and limitations}

  \textbf{Strengths:}
  \begin{itemize}
    \item \textbf{Mechanistic:} physically based --- valid under novel climates
    \item \textbf{Fine resolution:} hourly output captures diurnal cycles critical for organisms
    \item \textbf{Integrated:} combines solar, longwave, convection, soil heat, and moisture in one framework
    \item \textbf{Proven:} extensively validated against field observations
  \end{itemize}

  \vspace{0.3cm}

  \textbf{Limitations:}
  \begin{itemize}
    \item \textbf{Point-based:} no lateral heat flow --- represents one vertical column
    \item \textbf{Data-hungry:} requires many parameters; sensitive to input quality
    \item \textbf{No vegetation dynamics:} vegetation structure is prescribed, not predicted
  \end{itemize}
\end{frame}

\section{Conclusions}
\subsection{The big picture}

\begin{frame}
  \frametitle{What NicheMapR enables}

  \begin{itemize}
    \item Predicting microclimate at the spatial and temporal scales that actually matter to organisms
    \item Connecting macroclimate (weather data) to organism experience (temperature at the nest, the leaf litter, the burrow)
    \item Mechanistic species distribution modelling --- asking not just where species occur, but why and whether they will persist
  \end{itemize}

  \vspace{0.3cm}

  \begin{alertblock}{Core insight}
    Organisms experience microclimates, not climate averages. To understand their biology and predict their fate, we must model the environment at their scale.
  \end{alertblock}
\end{frame}

