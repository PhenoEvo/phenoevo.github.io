            \(\bullet\) nest temperature
          };
          \draw[connector,->,blue!75] (HS.west) -| (ST.south);
          \draw[connector,->,blue!75] (ED.south) -- (ST.north);
        }
        \uncover<4->{
          \draw[connector,->,cyan!75] (ST.east) -- (NM.west);
        }
      \end{tikzpicture}
    \end{center}
    \caption{We can model the microclimates eggs experience at relevant temporal and spatial scales. Based on \textcite{mitchell2016}}\label{fig:egg-microclimate}
  \end{figure}

\end{frame}

